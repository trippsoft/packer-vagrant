require 'securerandom'

BOX_DIR = File.expand_path(File.dirname(__FILE__))
LOCAL_NVRAM = "/tmp/#{SecureRandom.uuid}.fd"

if File.exist?("#{BOX_DIR}/efivars.fd") && !File.exist?(LOCAL_NVRAM)
  require 'fileutils'
  FileUtils.mkdir_p(File.dirname(LOCAL_NVRAM))
  FileUtils.cp("#{BOX_DIR}/efivars.fd", LOCAL_NVRAM)
end

Vagrant.configure(2) do |config|
  config.vm.boot_timeout = 600
  config.vm.synced_folder '.', '/vagrant', disabled: true

  config.vm.provider 'libvirt' do |lv|
    lv.cpus = 2
    lv.memory = 4096
    lv.disk_driver :discard => 'unmap', :detect_zeroes => 'unmap'
    lv.machine_type = 'q35'
    lv.nested = true
    lv.loader = "/usr/share/edk2/ovmf/OVMF_CODE.secboot.fd"
    lv.nvram = LOCAL_NVRAM
    lv.video_type = 'vga'
    lv.input :type => 'tablet', :bus => 'usb'
  end
end
